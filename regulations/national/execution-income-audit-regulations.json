  "application_policy": {
    "auto_apply": false,
    "rule": "此紀錄支援所得估算及費用分類；個案費用是否必要、比例及憑證有效性仍由納稅人留存資料並依稽徵機關查核，不可將試算當成核定所得。"
  }
