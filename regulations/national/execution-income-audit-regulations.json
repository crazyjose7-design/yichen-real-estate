  "important_provisions": [
    {
      "article": "第3條",
      "topic": "執行業務所得計算原則上採收付實現制"
    },
    {
      "article": "第8條",
      "topic": "能提供帳簿憑證者依帳載核實認定；未能提示者依法依費用標準核定"
    },
    {
      "article": "第14條",
      "topic": "非屬執行業務直接必要費用不得列支"
    },
    {
      "article": "第15條",
      "topic": "執行業務場所兼作非業務使用，租金等費用須按業務使用比例計算"
    },
    {
      "article": "第17條",
      "topic": "費用及損失須有原始憑證"
    },
    {
      "article": "第30條",
      "topic": "業務固定資產折舊採平均法，依耐用年數及成本限制計算"
    }
  ],
  "source": {
