  "important_provisions": [
    {
      "article": "第2條",
      "topic": "中央及地方主管機關"
    },
    {
      "article": "第65條第1項",
      "topic": "一般都市更新容積獎勵上限：原則不得超過基準容積1.5倍，且不得超過都市計畫法施行細則上限"
    },
    {
      "article": "第65條第2項",
      "topic": "特定合法既有建築物及策略性更新地區之擇優容積上限，須按各款條件判斷"
    },
    {
      "article": "第65條第3項",
      "topic": "符合特定耐震不足且有明顯公共安全危害之建築物，適用特別上限後不得再申請第5項獎勵"
    },
    {
      "article": "第65條第5項",
      "topic": "中央訂定獎勵辦法；地方得依都市發展特性另訂自治法規"
    },
    {
      "article": "第65條第6項",
      "topic": "地方自治法規獎勵額度原則上不得超過基準容積0.2倍；策略性更新地區特定案件不得超過0.4倍"
    },
    {
      "article": "第65條第10項",
      "topic": "新舊法過渡適用，依事業計畫擬訂報核日期判斷"
    }
  ],
